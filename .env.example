# Copy to .env (git-ignored) and fill in.

# OpenRouter API key for the drafting chat assistant (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Optional: comma-separated models, tried in order. Default: free models
# (nvidia/nemotron-3.5-super-vl:free, nvidia/nemotron-3-ultra-550b-a55b:free, google/gemma-4-31b-it:free).
# For faster, paid answers:
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
